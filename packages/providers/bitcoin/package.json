{
	"name": "@aquarian-metals/coin-moebius-bitcoin",
	"version": "4.3.1",
	"description": "Self-hosted Bitcoin provider for Coin Moebius — direct Bitcoin Core RPC integration. No third-party gateway, no custodial keys, no API tokens. The merchant runs bitcoind with a watch-only wallet and a small indexer; this package supplies the browser provider, the server-side creator (a fresh address per checkout), the webhook verifier, and the indexer factory.",
	"keywords": [
		"payments",
		"bitcoin",
		"btc",
		"crypto",
		"self-hosted",
		"bitcoin-core",
		"rpc",
		"webhook",
		"coin-moebius"
	],
	"author": "aquarian-metals",
	"license": "MIT",
	"homepage": "https://github.com/aquarian-metals/coin-moebius#readme",
	"bugs": {
		"url": "https://github.com/aquarian-metals/coin-moebius/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aquarian-metals/coin-moebius.git",
		"directory": "packages/providers/bitcoin"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "tsc",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@aquarian-metals/coin-moebius-core": "^4.3.1"
	},
	"devDependencies": {
		"@aquarian-metals/coin-moebius-server": "^4.3.1",
		"typescript": "~5.8.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
