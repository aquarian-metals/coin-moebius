{
	"name": "@aquarian-metals/coin-moebius-zano",
	"version": "4.2.3",
	"description": "Self-hosted Zano provider for Coin Moebius — direct wallet-RPC integration for ZANO and Zano assets such as Freedom Dollar. No third-party gateway, no custodial keys. The merchant runs zanod + simplewallet and a small indexer; this package supplies the browser provider, the server-side creator (integrated addresses), the webhook verifier, and the indexer factory.",
	"keywords": [
		"payments",
		"zano",
		"freedom-dollar",
		"fusd",
		"stablecoin",
		"crypto",
		"self-hosted",
		"wallet-rpc",
		"webhook",
		"coin-moebius"
	],
	"author": "aquarian-metals",
	"license": "MIT",
	"homepage": "https://github.com/aquarian-metals/coin-moebius#readme",
	"bugs": {
		"url": "https://github.com/aquarian-metals/coin-moebius/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aquarian-metals/coin-moebius.git",
		"directory": "packages/providers/zano"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "tsc",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@aquarian-metals/coin-moebius-core": "^4.2.3"
	},
	"devDependencies": {
		"@aquarian-metals/coin-moebius-server": "^4.2.3",
		"typescript": "~5.8.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
